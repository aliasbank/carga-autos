# Keep the app reachable only through Nginx on the same host.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8787

# Leave empty for a dedicated hostname. Use /cargadores when Nginx serves the
# app at https://appsec.televisaunivision.com/cargadores/.
APP_BASE_PATH=

# Generate a value with: openssl rand -hex 32
# Do not commit or share the real value.
QUEUE_AUTOMATION_TOKEN=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
